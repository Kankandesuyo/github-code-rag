DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: set this before exposing the service outside localhost.
# Protected endpoints then require: X-API-Key: your-secret
APP_API_KEY=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
CHROMA_ANONYMIZED_TELEMETRY=false
FORCE_HTTPS=false
GITHUB_API_TIMEOUT_SECONDS=30
# Optional: set a GitHub token to raise API rate limits. Keep it server-side only.
GITHUB_TOKEN=

# Optional
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
HASH_EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=10
RETRIEVAL_CANDIDATE_K=30
CONTEXT_EXPANSION_WINDOW=1
ENABLE_QUERY_EXPANSION=true
ENABLE_HYDE=true
ENABLE_LOCAL_RERANK=true
ENABLE_LLM_RERANK=false
MAX_FINAL_CONTEXT_CHUNKS=10
