DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Keep "local" for an open developer workstation. Set "production" before deployment;
# production startup fails unless either complete administrator auth or APP_API_KEY is configured.
DEPLOYMENT_MODE=local
# Comma-separated Host header allowlist. Add the public hostname when deploying behind a proxy.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Canonical external HTTPS URL used for redirects; do not include credentials, query, or fragment.
PUBLIC_BASE_URL=https://localhost

# API-key-only production is supported and does not require AUTH_SESSION_SECRET.
# Production APP_API_KEY values must contain at least 32 characters.
# Protected endpoints then require: X-API-Key: your-secret
APP_API_KEY=

# Optional single-administrator browser login. Configure all three together;
# production browser sessions also require AUTH_COOKIE_SECURE=true.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Maximum distinct active login sources held in one process. New sources fail closed when full.
LOGIN_RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# Maximum distinct active business-rate-limit sources held in one process. New sources fail closed when full.
RATE_LIMIT_MAX_BUCKETS=10000
# Append-only security events. Keep the path outside served/static directories.
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_LOG_PATH=logs/security_audit.jsonl
CHROMA_ANONYMIZED_TELEMETRY=false
FORCE_HTTPS=false
# Set true only when a trusted reverse proxy terminates TLS. This is an operator assertion:
# restrict Uvicorn --forwarded-allow-ips to that proxy instead of trusting arbitrary proxy headers.
TLS_TERMINATED_BY_PROXY=false
GITHUB_API_TIMEOUT_SECONDS=30
# Overall GitHub import safeguards. Requests and directories are counted across
# both the GitHub API path and the public web fallback.
MAX_REPOSITORY_DIRECTORIES=1000
MAX_REPOSITORY_REQUESTS=2500
REPOSITORY_IMPORT_TIMEOUT_SECONDS=300
# Current architecture supports exactly 1 concurrent import. Values above 1 require
# per-repository locks and unique staging directories before they are safe.
MAX_CONCURRENT_IMPORTS=1
# Optional: set a GitHub token to raise API rate limits. Keep it server-side only.
GITHUB_TOKEN=

# Optional
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
HASH_EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=10
RETRIEVAL_CANDIDATE_K=30
CONTEXT_EXPANSION_WINDOW=1
ENABLE_QUERY_EXPANSION=true
ENABLE_HYDE=true
ENABLE_LOCAL_RERANK=true
ENABLE_LLM_RERANK=false
MAX_FINAL_CONTEXT_CHUNKS=10
